# Site backups and plugin logs: private data, never committed.
wordpress-backups/
log.*.txt

# The packaged theme, rebuilt with npm run wp:zip.
wordpress-theme/*.zip

# Directory for documentation purposes
docs/wordpress-integration/etc

# Local handoff notes, internal task reports, and unused image candidates.
docs/project/SESSION_CONTINUITY_*.md
docs/hosting/*.pdf
public/new/

# Local access register; may contain credentials after it is filled in.
local-credentials/

# Local working files: article drafts for the WordPress posts, exported copies of documents kept
# here in Markdown or published elsewhere, and feedback screenshots.
/*Article_*.docx
docs/project/*.docx
docs/project/*.pdf
docs/seo/SEO Campaign for Australian States.pdf
/image*.png
docs/wordpress-integration/image*.png

# Google Business Profile screenshots: they show managers' email addresses.
google-my-business/

# PHP upgrade working files: .htaccess copies, server error log, cPanel screenshots, patched plugin files.
wordpress-upgrade/
