node_modules
dist
.DS_Store
*.local
*.log
.env
.env.*
!.env.example

# Plugin logs.
log.*.txt

# The packaged theme, rebuilt with npm run wp:zip.
wordpress-theme/*.zip

# Directory for documentation purposes
docs/wordpress-integration/etc

# Local handoff notes, internal task reports, and unused image candidates.
docs/project/SESSION_CONTINUITY_*.md
docs/hosting/*.pdf
public/new/

# Local working files: article drafts for the WordPress posts, exported copies of documents kept
# here in Markdown or published elsewhere, and feedback screenshots.
/*Article_*.docx
docs/project/*.docx
docs/project/*.pdf
docs/seo/SEO Campaign for Australian States.pdf
/image*.png
docs/wordpress-integration/image*.png

# The hosted-website inventory: it maps weaknesses on live servers.
docs/hosting/WEBSITE_INVENTORY_*

# Private working files, never committed: site backups (wordpress-backups), Wordfence scan results
# (wordpress-security), PHP upgrade files (wordpress-upgrade), Google Business Profile screenshots
# (google-my-business) and the local access register (local-credentials).
private/

# Files kept beside the project but not part of it: the team's action tracker (holds a password, and
# is over GitHub's 100 MB limit), HR forms that name staff and clients, and unrelated personal work.
misc/
