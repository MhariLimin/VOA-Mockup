# The packaged theme, rebuilt with npm run wp:zip.
wordpress-theme/*.zip

# Directory for documentation purposes
docs/wordpress-integration/etc

# Local handoff notes, internal task reports, and unused image candidates.
docs/project/SESSION_CONTINUITY_*.md
docs/wordpress-integration/TASK.md
docs/wordpress-integration/TASK.txt
public/new/

# Local access register; may contain credentials after it is filled in.
local-credentials/

# Local working files: article drafts for the WordPress posts, exported copies of documents kept
