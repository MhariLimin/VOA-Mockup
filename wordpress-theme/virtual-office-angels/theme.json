{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "73.75rem",
			"wideSize": "90rem"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "background",
					"color": "#f7f6f2",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "text",
					"color": "#102235",
					"name": "Text"
				},
				{
					"slug": "muted",
					"color": "#526173",
					"name": "Muted text"
				},
				{
					"slug": "accent",
					"color": "#075fae",
					"name": "Accent blue"
				},
				{
					"slug": "action",
					"color": "#ee7d16",
					"name": "Action orange"
				},
				{
					"slug": "heading-accent",
					"color": "#dc4f1e",
					"name": "Heading accent"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Manrope",
					"fontFamily": "'Manrope', system-ui, sans-serif"
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "'Inter', system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "1.125rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "1.75rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "2.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Tight",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "Small",
					"size": "1.25rem"
				},
				{
					"slug": "40",
					"name": "Medium",
					"size": "2rem"
				},
				{
					"slug": "50",
					"name": "Large",
					"size": "3.5rem"
				},
				{
					"slug": "60",
					"name": "Section",
					"size": "clamp(3.5rem, 7vw, 7rem)"
				}
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false
		}
	},
	"_comment": "Settings only: the editor's palette, type and spacing choices. There is deliberately no \"styles\" section. WordPress prints theme.json styles on every front-end page — a body font size, heading line height, link colour and an underline on hover — and the React build has none of them, so they made pages differ from the approved design. All front-end styling comes from assets/css, regenerated from the React stylesheets. The palette is the light theme only; the dark theme lives in assets/css/themes.css under [data-theme='dark']. The fonts are declared once, in assets/css/fonts.css."
}
